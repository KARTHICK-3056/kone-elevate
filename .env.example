# ---------------------------------------------------------------------------
# KONE ELEVATE - example environment file
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Docker Compose / PostgreSQL deployment:
#   DATABASE_URL=postgresql+psycopg2://kone_admin:change_me@postgres:5432/kone_elevate
# Local development without PostgreSQL (default, zero-setup):
#   DATABASE_URL=sqlite:///./kone_elevate.db
DATABASE_URL=sqlite:///./kone_elevate.db

POSTGRES_DB=kone_elevate
POSTGRES_USER=kone_admin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# Host port for Postgres. Defaults to 55432 in docker-compose.yml, not 5432:
# the demo would otherwise collide with a locally installed Postgres.
POSTGRES_PORT=55432

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# --- QR passport ----------------------------------------------------------
# Public base URL encoded into every component QR code.
QR_BASE_URL=http://localhost:5173

# --- Machine learning -----------------------------------------------------
MODEL_PATH=models/random_forest.joblib
MODEL_METRICS_PATH=models/metrics.json
MODEL_VERSION=RF-v1.0-synthetic
DATASET_PATH=data/synthetic/dataset.csv
DATASET_RECORDS=10000
DATASET_SEED=42

# --- Security -------------------------------------------------------------
# DEBUG=true is required to boot with the placeholder SECRET_KEY below - the
# backend refuses to start otherwise. Set DEBUG=false and a real SECRET_KEY
# before anything resembling a real deployment.
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This key signs every session token. Rotating it signs everyone out.
SECRET_KEY=dev-only-insecure-key-change-me
# How long a sign-in lasts before the user must authenticate again.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# PBKDF2-HMAC-SHA256 iterations for password hashing. The work factor is the
# security: it costs an attacker the same per guess as it costs you per
# sign-in. Only ever raise it. Each hash records the count it was made with,
# so raising this does not invalidate existing passwords.
PBKDF2_ROUNDS=240000
# Fallback actor for audit entries written by scripts and migrations, which
# have no signed-in user. API requests never use it: their actor comes from
# the caller's verified token and nowhere else.
AUDIT_ACTOR_DEFAULT=system

# --- Self-service signup --------------------------------------------------
# Role a self-registered account gets once its email is verified. Keep this
# at the lowest privilege level: proving someone owns an inbox says nothing
# about what they should be allowed to do. Anything above this is granted by
# a supervisor through POST /api/v1/auth/users.
SIGNUP_DEFAULT_ROLE=technician
OTP_TTL_MINUTES=10
# Wrong guesses before a code is burned. Six digits is a million
# combinations - without a cap that is minutes of scripted guessing.
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email ----------------------------------------------------------------
# Leave SMTP_HOST empty to run with no mail server: verification codes are
# written to the backend log and to backend/data/outbox/ instead of being
# sent, and the API tells the UI that is what happened rather than claiming
# an email went out. Signup is fully demonstrable this way.
#
# To send real email, fill these in. For Gmail you must use an App Password
# (a 16-character token generated in your Google account), never your normal
# password - and put it in .env, which is gitignored, never in the code.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=KONE ELEVATE <no-reply@kone-elevate.demo>

# --- Prototype impact constants (NOT official KONE figures) ---------------
IMPACT_CO2_PER_KG_STEEL=1.9
IMPACT_CURRENCY=INR

# --- Vite (frontend build) ------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
